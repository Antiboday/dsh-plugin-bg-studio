{
  "name": "dsh-plugin-bg-studio",
  "version": "0.5.0",
  "description": "Background Studio for DeepSeek Harness (DSH): picture, transparent and frosted-glass modes plus an animated wallpaper engine — video / web / canvas / task-reactive character bundles, one-click Wallpaper Engine workshop import, theme-mood courtesy prompts. Also drives a beat-synced travelling wave across the official turn navigator's marks from the audio DSH itself plays (silence = rest). Text colors are never touched.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wallpaper",
    "background",
    "wallpaper-engine",
    "theme",
    "audio-visualizer",
    "turn-navigator",
    "spectrum"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Antiboday/dsh-plugin-bg-studio.git"
  },
  "homepage": "https://github.com/Antiboday/dsh-plugin-bg-studio#readme",
  "bugs": {
    "url": "https://github.com/Antiboday/dsh-plugin-bg-studio/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
